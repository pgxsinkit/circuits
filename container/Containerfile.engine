# The Circuits engine image, published as ghcr.io/pgxsinkit/circuits/engine by
# .github/workflows/images.yml: the Rust binary (apps/engine) that tails Postgres logical
# replication, maintains shapes/subqueries/aggregations, and serves the control-plane HTTP API.
#
# The build context is the repository root:
#   podman build -f container/Containerfile.engine -t localhost/circuits-engine:dev .
#
# The engine speaks plain HTTP to the durable-streams server, so the runtime image needs no OpenSSL
# and no CA certificates — just debian slim. (reqwest does carry rustls, statically linked, because
# dbsp's storage crate enables it; `ds::http_client` keeps the engine booting without CA roots.)

# Pinned to rust-toolchain.toml's version, so the image builds with the toolchain CI and local
# builds use (and rustup has nothing to download).
# Build and runtime stages both use Debian 13 (Trixie), keeping their glibc and libgcc compatible.
# images.yml publishes amd64 only; use Docker's official per-architecture repository directly.
FROM docker.io/amd64/rust:1.99.0-trixie AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
# Cargo loads every workspace member's manifest, so both members are copied; only the engine is
# built, with cargo's default release profile.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY apps/engine apps/engine
COPY apps/durable-streams apps/durable-streams
RUN cargo build --release --locked -p circuits-engine

FROM debian:trixie-slim
# The engine runs as its own user, never as root. It keeps nothing of its own on disk that outlives
# the process: what it writes (a large transaction's spill, the membership circuit's spill) goes to
# the temporary directory unless CIRCUITS_TXN_SPILL_DIR or CIRCUITS_SUBQ_STORAGE_DIR name another,
# and a directory named there has to be writable by uid 10001.
RUN useradd --system --uid 10001 --user-group --no-create-home --shell /usr/sbin/nologin circuits
COPY --from=build /repo/target/release/circuits-engine /usr/local/bin/circuits-engine
USER 10001:10001

# Required:
#   CIRCUITS_DS_URL   durable-streams base URL (e.g. http://ds:8791)
#   CIRCUITS_PG_URL   Postgres URL (wal_level=logical; the engine creates its slot)
# Optional:
#   CIRCUITS_PG_TABLES  comma list of `schema.name` / bare `name` (= public.<name>) /
#                           `schema.*`; `*` (the default here) = every `public` table with a PK
#   CIRCUITS_PG_SLOT    slot name (default circuits)
#   CIRCUITS_BIND       bind address (default here 0.0.0.0:7010)
#   CIRCUITS_LOG        tracing filter (default info)
#   CIRCUITS_TRACE      0/false/off unregisters the visualizer introspection endpoints
#                           (/trace /graph /state — unauthenticated when on; default on)
ENV CIRCUITS_BIND=0.0.0.0:7010 \
    CIRCUITS_PG_TABLES=*

EXPOSE 7010
HEALTHCHECK --interval=5s --timeout=3s --retries=12 \
  CMD ["/bin/bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/7010 && printf 'GET /health HTTP/1.0\\r\\n\\r\\n' >&3 && head -1 <&3 | grep -q 200"]
CMD ["circuits-engine"]
