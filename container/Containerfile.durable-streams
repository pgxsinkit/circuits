# syntax=docker/dockerfile:1
#
# The durable-streams log server image, published as ghcr.io/pgxsinkit/circuits/durable-streams
# by .github/workflows/images.yml: the Rust server in apps/durable-streams (crate
# `durable-streams`, binary `durable-streams-server`).
#
# The build context is the repository root:
#   podman build -f container/Containerfile.durable-streams -t localhost/circuits-durable-streams:dev .

# ---- build stage: compile the release binary (glibc, matches the runtime) ----
# Pinned to rust-toolchain.toml's version, so the image builds with the toolchain CI and local
# builds use (and rustup has nothing to download).
FROM rust:1.96.0-bookworm AS build
WORKDIR /repo
# Cargo loads every workspace member's manifest, so both members are copied; only the log server
# is built.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY apps/engine apps/engine
COPY apps/durable-streams apps/durable-streams
# The workspace's `release-durable-streams` profile (LTO, one codegen unit: the settings the log
# server has always been released with); its output lands in target/release-durable-streams/.
# Default features only (no `tier`/`telemetry`) — minimal image, matching the conformance matrix.
# To ship S3 tiering, add `--features tier` here AND `ca-certificates` to the runtime stage.
RUN cargo build --profile release-durable-streams --locked -p durable-streams

# ---- runtime stage: distroless (glibc cc), no shell / package manager ----
FROM gcr.io/distroless/cc-debian12 AS runtime
COPY --from=build /repo/target/release-durable-streams/durable-streams-server /usr/local/bin/durable-streams-server
# Protocol default port (PROTOCOL.md §13.1); override with `--port`.
EXPOSE 4437
ENTRYPOINT ["/usr/local/bin/durable-streams-server"]
# Bind all interfaces by default (the binary defaults to 127.0.0.1, unreachable
# from outside the container). Override by passing your own args. For persistence,
# mount a volume and add `--data-dir /your/path` (default is an ephemeral tmp dir).
CMD ["--host", "0.0.0.0"]
