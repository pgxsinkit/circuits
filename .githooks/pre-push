#!/usr/bin/env bash
# The pre-push gate: `bun run validate:full`, which is `validate` plus the integration suites (the
# engine conformance harness, which boots Postgres, the engine and the log server, and the Durable
# Streams protocol suite against the log server's release build). It is what CI runs. `bun install`
# installs the hooks through the `prepare` script; bun runs through scripts/with-toolchain.sh, so a
# git client that never activated mise still gets the pinned bun, node and Rust.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# The harness boots its own Postgres with PostgreSQL 18's initdb and pg_ctl. Debian and Ubuntu keep
# them off PATH, in /usr/lib/postgresql/18/bin; use that directory when PATH has no initdb.
pg_bin=/usr/lib/postgresql/18/bin
if [[ -z "$(type -P initdb || true)" && -x "$pg_bin/initdb" ]]; then
  PATH="$pg_bin:$PATH"
  export PATH
fi

echo "→ Delegating pre-push checks to bun run validate:full"
bash scripts/with-toolchain.sh bun run validate:full
