{
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "newlinesBetween": true,
  },
  "sortPackageJson": {
    "sortScripts": true,
  },
  // docs/adr/, docs/notes/ and docs/superpowers/ are records, kept byte for byte as they were written.
  // Rust is formatted by `cargo fmt` (rustfmt.toml), not here.
  "ignorePatterns": [
    "**/dist/**",
    "docs/adr/**",
    "docs/notes/**",
    "docs/superpowers/**",
    "node_modules/**",
    "target/**",
    "tmp/**",
  ],
  "useTabs": false,
  "tabWidth": 2,
  "insertFinalNewline": true,
  "bracketSpacing": true,
}
