{
  "name": "circuits",
  "description": "Monorepo for Circuits — live queries for Postgres: a Rust engine ingests logical replication and keeps every query result (joins, aggregates, subqueries) in sync, speaking the Electric protocol plus an extended API.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:conformance": "vitest run packages/conformance",
    "test:fuzz": "vitest run packages/conformance/src/conformance-fuzz.test.ts",
    "engine:build": "cargo build -p circuits-engine",
    "engine:test": "cargo test -p circuits-engine",
    "loop": "bash scripts/conformance-loop.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "lmdb", "msgpackr-extract"]
  }
}
