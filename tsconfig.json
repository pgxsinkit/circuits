{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/conformance/scripts/**/*.ts",
    "apps/api/src/**/*.ts",
    "vitest.config.ts",
    "vitest.global-setup.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "target",
    "tmp"
  ]
}
